# Local development defaults. Copy this file to .env to override them.
TOMANAP_ENVIRONMENT=development
TOMANAP_DATABASE_URL=sqlite+aiosqlite:///./tomanap.db
TOMANAP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TOMANAP_ALLOWED_HOSTS=["localhost","127.0.0.1"]
TOMANAP_LOG_LEVEL=INFO
TOMANAP_SESSION_TTL_MINUTES=120
TOMANAP_RECONNECT_TTL_DAYS=7
TOMANAP_DEADLINE_WORKER_ENABLED=true
TOMANAP_DEADLINE_SWEEP_INTERVAL_SECONDS=1
TOMANAP_DEADLINE_SWEEP_BATCH_SIZE=100
TOMANAP_ENTRY_RATE_LIMIT_REQUESTS=60
TOMANAP_ENTRY_RATE_LIMIT_WINDOW_SECONDS=60
TOMANAP_ENTRY_RATE_LIMIT_MAX_KEYS=10000
TOMANAP_OUTBOX_WORKER_ENABLED=true
TOMANAP_OUTBOX_DISPATCH_INTERVAL_SECONDS=0.25
TOMANAP_OUTBOX_BATCH_SIZE=100
TOMANAP_OUTBOX_LEASE_SECONDS=30
TOMANAP_OUTBOX_RETRY_BASE_SECONDS=1
TOMANAP_OUTBOX_RETRY_MAX_SECONDS=60
TOMANAP_REALTIME_TICKET_TTL_SECONDS=30
TOMANAP_REALTIME_MAX_CONNECTIONS_PER_ROOM=24
TOMANAP_REALTIME_MAX_CONNECTIONS_PER_PLAYER=3
TOMANAP_REALTIME_HEARTBEAT_SECONDS=20
TOMANAP_REALTIME_IDLE_TIMEOUT_SECONDS=60
TOMANAP_REALTIME_MAX_MESSAGE_BYTES=4096
TOMANAP_IDEMPOTENCY_TTL_HOURS=24
TOMANAP_MAX_REQUEST_BODY_BYTES=65536
TOMANAP_SHUTDOWN_GRACE_SECONDS=10
TOMANAP_MAINTENANCE_WORKER_ENABLED=true
TOMANAP_MAINTENANCE_INTERVAL_SECONDS=3600
TOMANAP_MAINTENANCE_BATCH_SIZE=100
TOMANAP_CREDENTIAL_RETENTION_HOURS=24
TOMANAP_OUTBOX_RETENTION_DAYS=7
TOMANAP_COMPLETED_GAME_RETENTION_DAYS=30
# TOMANAP_REDIS_URL=redis://localhost:6379/0
TOMANAP_REDIS_CHANNEL_PREFIX=tomanap:room
TOMANAP_REDIS_RATE_LIMIT_PREFIX=tomanap:rate
TOMANAP_TELEMETRY_ENABLED=false
# TOMANAP_TELEMETRY_OTLP_ENDPOINT=http://localhost:4318
TOMANAP_TELEMETRY_EXPORT_INTERVAL_SECONDS=30
